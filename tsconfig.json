{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "vite-env.d.ts",
    "print_route_test.tsx",
    "src/**/*",
    "components/**/*",
    "pages/**/*",
    "services/**/*",
    "utils/**/*",
    "context/**/*",
    "hooks/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "functions",
    "functions/**/*"
  ]
}