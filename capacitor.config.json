
{
  "appId": "com.Labprox.app",
  "appName": "Labprox",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": ["*"],
    "cleartext": true
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "Haptics": {
      "enabled": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "showSpinner": true,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
